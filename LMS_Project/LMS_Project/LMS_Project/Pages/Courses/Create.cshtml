@page
@model LMS_Project.Pages.Courses.CreateModel

@{
    ViewData["Title"] = "Create Course";
}

<h2>Create Course</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Course.Title" class="form-label"></label>
        <input asp-for="Course.Title" class="form-control" />
        <span asp-validation-for="Course.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Course.Description" class="form-label"></label>
        <textarea asp-for="Course.Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Course.Credits" class="form-label"></label>
        <input asp-for="Course.Credits" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}