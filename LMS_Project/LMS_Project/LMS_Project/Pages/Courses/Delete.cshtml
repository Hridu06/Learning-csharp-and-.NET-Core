@page "{id:int}"
@model LMS_Project.Pages.Courses.DeleteModel

@{
    ViewData["Title"] = "Delete Course";
}

<h2>Delete Course</h2>

<h4 class="text-danger">Are you sure you want to delete this course?</h4>

<div class="card p-3 mt-3">
    <h4>@Model.Course.Title</h4>
    <p>@Model.Course.Description</p>
    <p><strong>Credits:</strong> @Model.Course.Credits</p>
    <p><strong>Instructor:</strong> @Model.Course.Instructor?.Name</p>
</div>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="Course.Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>