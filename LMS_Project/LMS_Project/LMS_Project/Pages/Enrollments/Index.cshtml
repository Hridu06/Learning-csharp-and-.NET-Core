@page
@model LMS_Project.Pages.Enrollments.IndexModel

@{
    ViewData["Title"] = "Enrollments";
}

<h2>Enrollments</h2>

<a asp-page="Create" class="btn btn-primary mb-3">Enroll Student</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Student</th>
            <th>Course</th>
            <th>Enrollment Date</th>
            <th>Grade</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Enrollments)
        {
            <tr>
                <td>@item.Student?.Name</td>
                <td>@item.Course?.Title</td>
                <td>@item.EnrollmentDate.ToShortDateString()</td>
                <td>@(item.Grade.HasValue? item.Grade.Value.ToString() : "Pending")</td>
                <td>
                    <a asp-page="Delete"
                       asp-route-studentId="@item.StudentId"
                       asp-route-courseId="@item.CourseId"
                       class="btn btn-danger btn-sm">
                        Remove
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>