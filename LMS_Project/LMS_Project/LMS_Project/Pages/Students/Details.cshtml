@page "{id:int}"
@model LMS_Project.Pages.Students.DetailsModel

@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>

<div class="card p-3 mt-3">
    <p><strong>ID:</strong> @Model.Student?.Id</p>
    <p><strong>Name:</strong> @Model.Student?.Name</p>
    <p><strong>Email:</strong> @Model.Student?.Email</p>
    <p><strong>Role:</strong> @Model.Student?.Role</p>
    <p><strong>Created Date:</strong> @(Model.Student != null ? Model.Student.CreatedDate.ToShortDateString() : "")</p>
    @(Model.Student != null && Model.Student.ModifiedDate.HasValue ? Model.Student.ModifiedDate.Value.ToShortDateString() : "")
</div>

<div class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Student?.Id" class="btn btn-warning">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</div>