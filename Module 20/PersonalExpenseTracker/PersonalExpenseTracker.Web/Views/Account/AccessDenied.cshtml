@{ ViewData["Title"] = "Access denied"; }
<div class="status-page">
    <div class="status-icon status-icon-danger"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
    <p class="status-code">403</p>
    <h1 class="h3 fw-bold">Access denied</h1>
    <p class="text-body-secondary">You don't have permission to view this page. If you think this is a mistake, contact the administrator.</p>
    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
        <button type="button" class="btn btn-outline-secondary" data-history-back><i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Go back</button>
        <a class="btn btn-primary" asp-controller="Summary" asp-action="Index"><i class="bi bi-house me-1" aria-hidden="true"></i> Back to dashboard</a>
    </div>
</div>
