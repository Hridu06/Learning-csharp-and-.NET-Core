@model IReadOnlyList<CategoryDto>
@{ ViewData["Title"] = "Categories"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h2 mb-1">Categories</h1><p class="text-muted mb-0">Organize your expenses into groups that make sense to you.</p></div>
    <a class="btn btn-primary" asp-action="Create">+ Add category</a>
</div>
<div class="card shadow-sm">
@if (Model.Count == 0)
{
    <div class="card-body text-center py-5">
        <h2 class="h5">No categories yet</h2>
        <p class="text-muted">Create a category before adding an expense.</p>
        <a class="btn btn-primary" asp-action="Create">Add your first category</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Name</th><th scope="col">Description</th><th scope="col" class="text-end">Expenses</th><th scope="col" class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td class="fw-semibold text-break">@category.Name</td>
                    <td class="text-muted text-break">@(category.Description ?? "No description")</td>
                    <td class="text-end">@category.ExpenseCount</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id" aria-label="Edit @category.Name">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id" aria-label="Delete @category.Name">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
</div>
<p class="text-muted small mt-3">Categories with linked expenses cannot be deleted.</p>
