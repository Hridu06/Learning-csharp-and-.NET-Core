@model ExpenseFormViewModel
@{ ViewData["Title"] = "Edit expense"; }
<div class="form-page mx-auto">
    <a asp-action="Index" class="text-decoration-none small">&larr; Back to expenses</a>
    <h1 class="h2 mt-3">Edit expense</h1>
    <p class="text-muted">Update the details below. Fields marked * are required.</p>
    <div class="card shadow-sm"><div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <partial name="_Form" model="Model" />
        </form>
    </div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
