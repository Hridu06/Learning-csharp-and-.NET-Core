@model IReadOnlyList<ExpenseDto>
@{ ViewData["Title"] = "Expenses"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h2 mb-1">Expenses</h1><p class="text-muted mb-0">A clear record of where your money goes.</p></div>
    <a class="btn btn-primary" asp-action="Create">+ Add expense</a>
</div>
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between gap-2 py-3">
        <span class="fw-semibold">All expenses <span class="badge text-bg-light ms-1">@Model.Count</span></span>
        <span class="text-muted">Total: <strong class="text-dark">BDT @Model.Sum(e => e.Amount).ToString("N2")</strong></span>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-center py-5">
            <h2 class="h5">No expenses yet</h2>
            <p class="text-muted">Add your first expense to start tracking your spending.</p>
            <a class="btn btn-primary" asp-action="Create">Add your first expense</a>
        </div>
    }
    else
    {
        <partial name="_ExpenseTable" model="Model" />
    }
</div>
