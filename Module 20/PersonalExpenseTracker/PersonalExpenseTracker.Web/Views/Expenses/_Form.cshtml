@model ExpenseFormViewModel
<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" role="alert"></div>

<div class="mb-3">
    <label asp-for="Title" class="form-label required"></label>
    <input asp-for="Title" class="form-control" maxlength="100" placeholder="e.g. Weekly groceries" autofocus="@(Model.Id == 0)" />
    <span asp-validation-for="Title"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Amount" class="form-label required"></label>
        <div class="input-group">
            <span class="input-group-text">৳</span>
            <input asp-for="Amount" class="form-control" type="number" min="0.01" max="9999999999999999.99" step="0.01"
                   placeholder="0.00" inputmode="decimal" />
        </div>
        <span asp-validation-for="Amount"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Date" class="form-label required"></label>
        <input asp-for="Date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
        <span asp-validation-for="Date"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="CategoryId" class="form-label required"></label>
    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
        <option value="">Select a category</option>
    </select>
    <span asp-validation-for="CategoryId"></span>
    @if (Model.Categories.Count == 0)
    {
        <div class="alert alert-warning d-flex gap-2 mt-2 mb-0">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div>Add a category before saving an expense. <a asp-controller="Categories" asp-action="Create" class="alert-link">Create a category</a>.</div>
        </div>
    }
</div>

<div class="mb-3">
    <label asp-for="Notes" class="form-label"></label> <span class="optional">(optional)</span>
    <textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000" placeholder="Anything worth remembering about this expense"></textarea>
    <span asp-validation-for="Notes"></span>
</div>

<div class="mb-4">
    <label asp-for="Receipt" class="form-label"></label> <span class="optional">(optional)</span>
    @if (Model.ExistingReceiptFileName is not null)
    {
        <div class="current-receipt mb-2">
            <img src="@Url.Content("~/uploads/receipts/" + Model.ExistingReceiptFileName)" alt="Current receipt" />
            <div class="flex-grow-1">
                <div class="fw-medium">Current receipt</div>
                <div class="small text-body-secondary">Upload a new image to replace it, or leave empty to keep it.</div>
            </div>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Receipt" asp-route-id="@Model.Id" target="_blank" rel="noopener">
                View <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i><span class="visually-hidden">(opens a new tab)</span>
            </a>
        </div>
    }
    @* The file input covers the whole drop zone, so click, keyboard and drag-and-drop all work natively. *@
    <div class="dropzone" data-dropzone data-max-bytes="2097152">
        <input asp-for="Receipt" type="file" accept=".jpg,.png" aria-describedby="receiptHelp" />
        <div class="dropzone-prompt" id="receiptHelp">
            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
            <div><strong class="text-primary">Click to upload</strong> or drag and drop</div>
            <div class="small text-body-secondary">JPG or PNG, up to 2 MB</div>
        </div>
        <div class="dropzone-preview d-none">
            <img alt="Selected receipt preview" />
            <div class="flex-grow-1 min-w-0">
                <div class="fw-medium text-truncate" data-file-name></div>
                <div class="small text-body-secondary" data-file-size></div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-dropzone-clear>Remove</button>
        </div>
    </div>
    <div class="field-validation-error d-none" data-dropzone-error></div>
    <span asp-validation-for="Receipt"></span>
</div>

<div class="form-actions">
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    <button type="submit" class="btn btn-primary" disabled="@(Model.Categories.Count == 0)" data-loading-text="Saving…">
        <i class="bi bi-check-lg me-1" aria-hidden="true"></i>@(Model.Id == 0 ? "Save expense" : "Save changes")
    </button>
</div>
