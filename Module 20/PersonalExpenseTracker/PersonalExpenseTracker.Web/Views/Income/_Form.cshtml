@model IncomeFormViewModel
<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" role="alert"></div>

<fieldset class="mb-4">
    <legend class="form-label required">Source</legend>
    <div class="source-grid">
        @foreach (var source in IncomeSources.All)
        {
            <input type="radio" class="btn-check" name="Source" id="source-@source.Source" value="@source.Source" autocomplete="off"
                   checked="@(Model.Source == source.Source)" data-val="true" data-val-required="Please choose a source." />
            <label class="source-option" for="source-@source.Source" style="--cat:@source.Color">
                <i class="bi bi-@source.Icon" aria-hidden="true"></i><span>@source.Label</span>
            </label>
        }
    </div>
    <span asp-validation-for="Source"></span>
</fieldset>

<div class="mb-3">
    <label asp-for="Title" class="form-label required"></label>
    <input asp-for="Title" class="form-control" maxlength="100" placeholder="e.g. November salary" autofocus="@(Model.Id == 0)" />
    <span asp-validation-for="Title"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Amount" class="form-label required"></label>
        <div class="input-group">
            <span class="input-group-text">৳</span>
            <input asp-for="Amount" class="form-control" type="number" min="0.01" max="9999999999999999.99" step="0.01"
                   placeholder="0.00" inputmode="decimal" />
        </div>
        <span asp-validation-for="Amount"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Date" class="form-label required"></label>
        <input asp-for="Date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
        <span asp-validation-for="Date"></span>
    </div>
</div>

<div class="mb-4">
    <label asp-for="Notes" class="form-label"></label> <span class="optional">(optional)</span>
    <textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000" placeholder="Anything worth remembering about this income"></textarea>
    <span asp-validation-for="Notes"></span>
</div>

<div class="form-actions">
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    <button type="submit" class="btn btn-primary" data-loading-text="Saving…">
        <i class="bi bi-check-lg me-1" aria-hidden="true"></i>@(Model.Id == 0 ? "Save income" : "Save changes")
    </button>
</div>
