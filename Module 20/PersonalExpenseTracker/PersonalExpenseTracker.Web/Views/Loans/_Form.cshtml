@model LoanFormViewModel
<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" role="alert"></div>

<fieldset class="mb-4">
    <legend class="form-label required">What happened?</legend>
    <div class="row g-2">
        <div class="col-sm-6">
            <input type="radio" class="btn-check" name="Type" id="type-borrowed" value="Borrowed" autocomplete="off"
                   checked="@(Model.Type == LoanType.Borrowed)" data-val="true" data-val-required="Choose whether you borrowed or lent the money." />
            <label class="loan-type-option" for="type-borrowed" style="--cat:#EF4444">
                <i class="bi bi-arrow-down-left" aria-hidden="true"></i>
                <span><strong class="d-block">I borrowed money</strong><span class="small text-body-secondary">Someone lent it to me; I need to repay</span></span>
            </label>
        </div>
        <div class="col-sm-6">
            <input type="radio" class="btn-check" name="Type" id="type-lent" value="Lent" autocomplete="off"
                   checked="@(Model.Type == LoanType.Lent)" />
            <label class="loan-type-option" for="type-lent" style="--cat:#16A34A">
                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                <span><strong class="d-block">I lent money</strong><span class="small text-body-secondary">I gave it to someone; they'll pay me back</span></span>
            </label>
        </div>
    </div>
    <span asp-validation-for="Type"></span>
</fieldset>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Person" class="form-label required"></label>
        <input asp-for="Person" class="form-control" maxlength="100" placeholder="e.g. Rahim, City Bank" autofocus="@(Model.Id == 0)" />
        <span asp-validation-for="Person"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Principal" class="form-label required"></label>
        <div class="input-group">
            <span class="input-group-text">৳</span>
            <input asp-for="Principal" class="form-control" type="number" min="0.01" max="9999999999999999.99" step="0.01" placeholder="0.00" inputmode="decimal" />
        </div>
        <span asp-validation-for="Principal"></span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="StartDate" class="form-label required"></label>
        <input asp-for="StartDate" asp-format="{0:yyyy-MM-dd}" class="form-control" />
        <span asp-validation-for="StartDate"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DueDate" class="form-label"></label> <span class="optional">(optional)</span>
        <input asp-for="DueDate" asp-format="{0:yyyy-MM-dd}" class="form-control" />
        <span asp-validation-for="DueDate"></span>
    </div>
</div>

<div class="mb-4">
    <label asp-for="Notes" class="form-label"></label> <span class="optional">(optional)</span>
    <textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000" placeholder="Terms, purpose or anything worth remembering"></textarea>
    <span asp-validation-for="Notes"></span>
</div>

<div class="form-actions">
    <a class="btn btn-outline-secondary" asp-action="@(Model.Id == 0 ? "Index" : "Details")" asp-route-id="@(Model.Id == 0 ? null : Model.Id)">Cancel</a>
    <button type="submit" class="btn btn-primary" data-loading-text="Saving…">
        <i class="bi bi-check-lg me-1" aria-hidden="true"></i>@(Model.Id == 0 ? "Save loan" : "Save changes")
    </button>
</div>
