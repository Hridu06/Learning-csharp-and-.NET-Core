@model ProfilePageViewModel
@{
    ViewData["Title"] = "My profile";
    var account = Model.Account;
    var section = Model.ActiveSection;
    var largeAvatar = new AvatarViewModel(account.FullName, account.AvatarFileName, "lg");
    var emailChanged = !string.Equals(Model.Profile.Email, account.Email, StringComparison.OrdinalIgnoreCase);
}

<div class="page-header">
    <div>
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Summary" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">My profile</li>
            </ol>
        </nav>
        <h1 class="page-title">My profile</h1>
        <p class="page-subtitle">Manage your personal details, password and account.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card profile-summary">
            <div class="card-body text-center p-4">
                <partial name="_Avatar" model="largeAvatar" />
                <h2 class="h5 fw-bold mt-3 mb-1 text-break">@account.FullName</h2>
                <p class="text-body-secondary mb-3 text-break">@account.Email</p>
                @if (account.IsAdmin)
                {
                    <span class="role-badge role-badge-admin"><i class="bi bi-shield-check" aria-hidden="true"></i> Administrator</span>
                }
                else
                {
                    <span class="role-badge"><i class="bi bi-person" aria-hidden="true"></i> Member</span>
                }
            </div>
            <div class="card-footer small text-body-secondary text-center">
                <i class="bi bi-calendar-check me-1" aria-hidden="true"></i>Member since @account.CreatedAt.ToLocalTime().ToString("MMMM yyyy")
            </div>
        </div>
        <nav class="card profile-nav mt-3 d-none d-lg-block" aria-label="Profile sections">
            <a href="#profile"><i class="bi bi-person-vcard" aria-hidden="true"></i> Personal information</a>
            <a href="#password"><i class="bi bi-key" aria-hidden="true"></i> Change password</a>
            <a href="#delete" class="text-danger"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Delete account</a>
        </nav>
    </div>

    <div class="col-lg-8 d-flex flex-column gap-4">
        <section class="card" id="profile" aria-labelledby="profileTitle">
            <div class="card-header">
                <h2 class="card-title" id="profileTitle">Personal information</h2>
                <p class="card-subtitle">Your name and picture appear in the sidebar.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Update" method="post" enctype="multipart/form-data" novalidate>
                    @if (section == "profile") { <div asp-validation-summary="ModelOnly" role="alert"></div> }

                    <div class="avatar-editor mb-4" data-avatar-editor>
                        <div class="avatar-editor-preview">
                            <partial name="_Avatar" model="largeAvatar" />
                            <img class="user-avatar user-avatar-lg d-none" alt="" data-avatar-preview />
                        </div>
                        <div>
                            <div class="d-flex flex-wrap gap-2 mb-1">
                                <label class="btn btn-sm btn-outline-secondary mb-0" for="Profile_Avatar">
                                    <i class="bi bi-upload me-1" aria-hidden="true"></i> Upload picture
                                </label>
                                <input asp-for="Profile.Avatar" type="file" accept=".jpg,.png" class="visually-hidden" data-max-bytes="2097152" />
                                @if (account.AvatarFileName is not null)
                                {
                                    <input type="checkbox" class="btn-check" asp-for="Profile.RemoveAvatar" autocomplete="off" />
                                    <label class="btn btn-sm btn-outline-danger mb-0" for="Profile_RemoveAvatar"><i class="bi bi-trash3 me-1" aria-hidden="true"></i> Remove</label>
                                }
                            </div>
                            <div class="small text-body-secondary" data-avatar-hint>JPG or PNG, up to 2 MB.</div>
                            <span asp-validation-for="Profile.Avatar"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Profile.FullName" class="form-label required"></label>
                            <input asp-for="Profile.FullName" class="form-control" maxlength="100" autocomplete="name" />
                            <span asp-validation-for="Profile.FullName"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Profile.Email" class="form-label required"></label>
                            <input asp-for="Profile.Email" class="form-control" autocomplete="email" data-original-email="@account.Email" />
                            <span asp-validation-for="Profile.Email"></span>
                        </div>
                    </div>

                    @* Only shown when the email changes; the server checks it in that case. *@
                    <div class="mb-3 @(emailChanged ? "" : "d-none")" data-email-password>
                        <label asp-for="Profile.CurrentPassword" class="form-label required"></label>
                        <input asp-for="Profile.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <div class="form-text">Changing your sign-in email requires your current password.</div>
                        <span asp-validation-for="Profile.CurrentPassword"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" data-loading-text="Saving…"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save changes</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="card" id="password" aria-labelledby="passwordTitle">
            <div class="card-header">
                <h2 class="card-title" id="passwordTitle">Change password</h2>
                <p class="card-subtitle">Use a strong password you don't use anywhere else.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post" novalidate>
                    @if (section == "password") { <div asp-validation-summary="ModelOnly" role="alert"></div> }
                    <div class="mb-3">
                        <label asp-for="Password.CurrentPassword" class="form-label required"></label>
                        <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password.CurrentPassword"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password.NewPassword" class="form-label required"></label>
                            <div class="input-group">
                                <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" data-password-rules="#passwordRules" />
                                <button class="btn btn-outline-secondary" type="button" data-password-toggle aria-label="Show password"><i class="bi bi-eye" aria-hidden="true"></i></button>
                            </div>
                            <span asp-validation-for="Password.NewPassword"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password.ConfirmPassword" class="form-label required"></label>
                            <input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password.ConfirmPassword"></span>
                        </div>
                    </div>
                    <partial name="_PasswordRules" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" data-loading-text="Updating…"><i class="bi bi-key me-1" aria-hidden="true"></i>Update password</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="card danger-zone" id="delete" aria-labelledby="deleteTitle">
            <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h2 class="card-title text-danger" id="deleteTitle">Delete account</h2>
                    <p class="card-subtitle mb-0">Permanently delete your account, expenses, categories and receipts. This can't be undone.</p>
                </div>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i> Delete account
                </button>
            </div>
        </section>
    </div>
</div>

<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountTitle" aria-hidden="true"
     data-show-on-load="@(section == "delete" ? "true" : "false")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Delete" method="post" novalidate>
                <div class="modal-body p-4">
                    <div class="text-center">
                        <div class="modal-icon mb-3"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i></div>
                        <h2 class="h5 mb-2" id="deleteAccountTitle">Delete your account?</h2>
                        <p class="text-body-secondary">All of your expenses, categories and receipts will be permanently deleted.</p>
                    </div>
                    @if (section == "delete") { <div asp-validation-summary="ModelOnly" role="alert"></div> }
                    <label asp-for="Delete.Password" class="form-label">Enter your password to confirm</label>
                    <input asp-for="Delete.Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Delete.Password"></span>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger flex-fill" data-loading-text="Deleting…">Delete my account</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
