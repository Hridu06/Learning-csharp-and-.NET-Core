@foreach (var (key, style) in new[] { ("Success", "success"), ("Error", "danger"), ("Warning", "warning") })
{
    if (TempData[key] is string message)
    {
        <div class="alert alert-@style alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
        </div>
    }
}
