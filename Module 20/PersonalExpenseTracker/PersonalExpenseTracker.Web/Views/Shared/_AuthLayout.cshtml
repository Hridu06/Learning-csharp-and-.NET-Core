<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Track your personal expenses, organize categories and keep receipts in one place." />
    <title>@ViewData["Title"] · Expense Tracker</title>
    <script>
        (function () {
            var theme;
            try { theme = localStorage.getItem('theme'); } catch (e) { }
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-shell">
        <aside class="auth-brand" aria-hidden="true">
            <div class="brand"><img src="~/favicon.svg" width="40" height="40" alt="" /><span>Expense<strong>Tracker</strong></span></div>
            <div>
                <h2 class="auth-brand-title">Take control of where your money goes.</h2>
                <ul class="auth-features list-unstyled">
                    <li><i class="bi bi-graph-up-arrow"></i><span>See monthly trends and your top categories at a glance</span></li>
                    <li><i class="bi bi-receipt"></i><span>Keep receipts attached to every expense</span></li>
                    <li><i class="bi bi-shield-lock"></i><span>Your data is private to your account</span></li>
                </ul>
            </div>
            <p class="auth-brand-foot">&copy; @DateTime.Now.Year Personal Expense Tracker</p>
        </aside>

        <main class="auth-main" id="main-content">
            <div class="auth-topbar">
                <a class="brand d-lg-none" asp-controller="Account" asp-action="Login">
                    <img src="~/favicon.svg" width="32" height="32" alt="" /><span>Expense<strong>Tracker</strong></span>
                </a>
                <button type="button" class="btn btn-icon ms-auto" data-theme-toggle aria-label="Toggle dark mode">
                    <i class="bi bi-moon-stars theme-icon-light" aria-hidden="true"></i>
                    <i class="bi bi-sun theme-icon-dark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="auth-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <partial name="_Alerts" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
