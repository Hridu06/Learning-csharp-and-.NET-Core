@*
    Shared confirmation dialog. Open it from any button with:
    data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="..." data-delete-name="..." data-delete-message="..."
    site.js copies those values into the form before it is shown.
*@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-antiforgery="true" data-delete-form>
                <input type="hidden" name="returnUrl" data-delete-return />
                <div class="modal-body text-center p-4 pb-3">
                    <div class="modal-icon mb-3"><i class="bi bi-trash3" aria-hidden="true"></i></div>
                    <h2 class="h5 mb-2" id="deleteModalTitle">Delete <span class="text-break" data-delete-name></span>?</h2>
                    <p class="text-body-secondary mb-0" data-delete-message>This action cannot be undone.</p>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary flex-fill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger flex-fill" data-loading-text="Deleting…">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>
