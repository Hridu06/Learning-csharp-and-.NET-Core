@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Track your personal expenses, organize categories and keep receipts in one place." />
    <title>@ViewData["Title"] - Personal Expense Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Summary" asp-action="Index">Personal Expense Tracker</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end" id="mainNav">
                    <ul class="navbar-nav gap-sm-2">
                        <li class="nav-item"><a class="nav-link @(controller == "Expenses" ? "active fw-semibold" : "")" aria-current="@(controller == "Expenses" ? "page" : null)" asp-controller="Expenses" asp-action="Index">Expenses</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Categories" ? "active fw-semibold" : "")" aria-current="@(controller == "Categories" ? "page" : null)" asp-controller="Categories" asp-action="Index">Categories</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Summary" ? "active fw-semibold" : "")" aria-current="@(controller == "Summary" ? "page" : null)" asp-controller="Summary" asp-action="Index">Summary</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>
    <footer class="border-top bg-white py-3 mt-auto">
        <div class="container text-muted small">Personal Expense Tracker &middot; All amounts in BDT</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
