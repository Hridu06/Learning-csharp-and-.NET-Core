@* Mirrors the Identity password options in PersonalExpenseTracker.Service/DependencyInjection.cs; site.js ticks rules off as the user types. *@
<ul class="password-rules list-unstyled" id="passwordRules">
    <li data-rule="length"><i class="bi bi-circle" aria-hidden="true"></i>At least 8 characters</li>
    <li data-rule="upper"><i class="bi bi-circle" aria-hidden="true"></i>An uppercase letter</li>
    <li data-rule="lower"><i class="bi bi-circle" aria-hidden="true"></i>A lowercase letter</li>
    <li data-rule="digit"><i class="bi bi-circle" aria-hidden="true"></i>A number</li>
</ul>
